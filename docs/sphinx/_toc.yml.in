# Anywhere {branch} is used, the branch name will be substituted.
# These comments will also be removed.
defaults:
  numbered: False
  maxdepth: 6
root: index.rst
subtrees:
  - entries:
      - url: https://rocm.docs.amd.com/en/7.10.0-preview/
